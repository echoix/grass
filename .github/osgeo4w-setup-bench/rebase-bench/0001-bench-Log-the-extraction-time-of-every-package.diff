From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 9 Oct 2026 22:45:04 +0000
Subject: [PATCH] bench: Log the extraction time of every package


diff --git a/install.cc b/install.cc
index 59b1685..327c461 100644
--- a/install.cc
+++ b/install.cc
@@ -597,6 +597,14 @@ Installer::installOne (packagemeta &pkgm, const packageversion &ver,
   package_bytes = source.size;
   Log (LOG_PLAIN) << "Extracting from " << source.Cached () << endLog;
 
+  /* Benchmark: the span runs from before the first archive entry is read to
+     after the last one is extracted (both passes, if there are two), and does
+     not include opening the package or writing the file list.  */
+  LARGE_INTEGER bench_freq, bench_start, bench_end;
+  QueryPerformanceFrequency (&bench_freq);
+  QueryPerformanceCounter (&bench_start);
+  const int bench_entries_before = num_installs;
+
   saw_symlink = false;
   bool error_in_this_package = _installOne(pkgm, prefixURL, prefixPath, owner,
                                            pkgfile, tarstream, lst, false);
@@ -614,6 +622,22 @@ Installer::installOne (packagemeta &pkgm, const packageversion &ver,
                                        pkgfile, tarstream, lst, true);
   }
 
+  QueryPerformanceCounter (&bench_end);
+  Log (LOG_PLAIN) << "Extracted " << pkgm.name << ": "
+                  << (num_installs - bench_entries_before) << " entries in "
+                  << ((bench_end.QuadPart - bench_start.QuadPart) * 1000 / bench_freq.QuadPart)
+                  << " ms" << endLog;
+  /* The log is only written when setup exits, so also append the result to a
+     file as soon as it is known.  */
+  if (const char *timing_file = getenv ("OSGEO4W_EXTRACT_TIMING_FILE"))
+    if (FILE *f = fopen (timing_file, "a"))
+      {
+        fprintf (f, "Extracted %s: %d entries in %lld ms\n", pkgm.name.c_str (),
+                 num_installs - bench_entries_before,
+                 (long long) ((bench_end.QuadPart - bench_start.QuadPart) * 1000 / bench_freq.QuadPart));
+        fclose (f);
+      }
+
   if (lst)
     delete lst;
   delete tarstream;
