@@ -202,6 +203,7 @@ endif
 	IniDBBuilderPackage.h \
 	license.cc \
 	osgeo4w.cc \
+	osgeo4w_files.cc \
 	license.h \
 	osgeo4w.h \
 	inilex.ll \
diff --git a/osgeo4w.cc b/osgeo4w.cc
index 843662e..56d9674 100644
--- a/osgeo4w.cc
+++ b/osgeo4w.cc
@@ -45,30 +45,6 @@ osgeo4w_process_options ()
     menu_name = (std::string) MenuNameOption;
 }
 
-bool
-osgeo4w_cygwin_file_semantics ()
-{
-  static int cached = -1;
-  if (cached < 0)
-    {
-      const char *v = getenv ("OSGEO4W_SETUP_FILE_SEMANTICS");
-      cached = v && !strcmp (v, "cygwin");
-    }
-  return cached;
-}
-
-bool
-osgeo4w_skip_symlink_pass ()
-{
-  static int cached = -1;
-  if (cached < 0)
-    {
-      const char *v = getenv ("OSGEO4W_SETUP_SKIP_SYMLINK_PASS");
-      cached = v ? (v[0] == '1') : !osgeo4w_cygwin_file_semantics ();
-    }
-  return cached;
-}
-
 bool
 get_issystem ()
 {
diff --git a/osgeo4w_files.cc b/osgeo4w_files.cc
new file mode 100644
index 0000000..9826436
--- /dev/null
+++ b/osgeo4w_files.cc
@@ -0,0 +1,37 @@
+/*
+ * How files are extracted, see osgeo4w.h.  This is a file of its own because
+ * filemanip.cc, which every tool of setup links, calls it.
+ */
+
+#ifdef OSGEO4W
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "osgeo4w.h"
+
+bool
+osgeo4w_cygwin_file_semantics ()
+{
+  static int cached = -1;
+  if (cached < 0)
+    {
+      const char *v = getenv ("OSGEO4W_SETUP_FILE_SEMANTICS");
+      cached = v && !strcmp (v, "cygwin");
+    }
+  return cached;
+}
+
+bool
+osgeo4w_skip_symlink_pass ()
+{
+  static int cached = -1;
+  if (cached < 0)
+    {
+      const char *v = getenv ("OSGEO4W_SETUP_SKIP_SYMLINK_PASS");
+      cached = v ? (v[0] == '1') : !osgeo4w_cygwin_file_semantics ();
+    }
+  return cached;
+}
+
+#endif /* OSGEO4W */
