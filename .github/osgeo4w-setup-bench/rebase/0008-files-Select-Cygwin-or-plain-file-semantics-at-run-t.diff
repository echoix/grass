From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 9 Oct 2026 22:42:49 +0000
Subject: [PATCH] files: Select Cygwin or plain file semantics at run time and
 skip the symlink pass for packages without symlinks


diff --git a/filemanip.cc b/filemanip.cc
index ca5e4ac..eaff97a 100644
--- a/filemanip.cc
+++ b/filemanip.cc
@@ -20,6 +20,7 @@
 #include <wchar.h>
 #include <stdlib.h>
 #include "filemanip.h"
+#include "osgeo4w.h"
 #include "io_stream.h"
 #include "String++.h"
 #include "win32.h"
@@ -438,6 +439,11 @@ nt_wfopen (const wchar_t *wpath, const char *mode, mode_t perms)
   ULONG access, disp;
   int oflags = 0;
 
+#ifdef OSGEO4W
+  if (!osgeo4w_cygwin_file_semantics ())
+    perms = 0;
+#endif
+
   switch (mode[0])
     {
     case 'r':
diff --git a/install.cc b/install.cc
index 3b13079..59b1685 100644
--- a/install.cc
+++ b/install.cc
@@ -122,6 +122,7 @@ class Installer
   private:
     bool extract_replace_on_reboot(archive *, const std::string&,
                                    const std::string&, std::string);
+    bool saw_symlink;
 #ifdef OSGEO4W
     bool replace_inuse_file(archive *, const std::string&,
                             const std::string&, const std::string&);
@@ -596,13 +597,22 @@ Installer::installOne (packagemeta &pkgm, const packageversion &ver,
   package_bytes = source.size;
   Log (LOG_PLAIN) << "Extracting from " << source.Cached () << endLog;
 
+  saw_symlink = false;
   bool error_in_this_package = _installOne(pkgm, prefixURL, prefixPath, owner,
                                            pkgfile, tarstream, lst, false);
+#ifdef OSGEO4W
+  /* Reading the package again just for the symlinks is pointless if it has none */
+  if (!saw_symlink && osgeo4w_skip_symlink_pass ())
+    ;
+  else
+#endif
+  {
   if (tarstream->seek(0, IO_SEEK_SET) == -1)
     Log (LOG_PLAIN) << "Error rewinding to extract symlinks" << source.Cached () << endLog;
 
   error_in_this_package |= _installOne(pkgm, prefixURL, prefixPath, owner,
                                        pkgfile, tarstream, lst, true);
+  }
 
   if (lst)
     delete lst;
@@ -635,6 +645,8 @@ Installer::_installOne (packagemeta &pkgm,
   std::string fn;
   while ((fn = tarstream->next_file_name ()).size ())
     {
+      if (tarstream->next_file_type () == ARCHIVE_FILE_SYMLINK)
+        saw_symlink = true;
       if (symlink_phase != (tarstream->next_file_type () == ARCHIVE_FILE_SYMLINK))
         {
           tarstream->skip_file();
diff --git a/main.cc b/main.cc
index 2f3c8a2..d3cb8a7 100644
--- a/main.cc
+++ b/main.cc
@@ -418,6 +418,9 @@ WinMain (HINSTANCE h,
       }
 
     /* Set default DACL and Group. */
+#ifdef OSGEO4W
+    if (osgeo4w_cygwin_file_semantics ())
+#endif
     nt_sec.setDefaultSecurity ();
 
     /*
diff --git a/mkdir.cc b/mkdir.cc
index 20a9ba6..7fa30f8 100644
--- a/mkdir.cc
+++ b/mkdir.cc
@@ -22,6 +22,7 @@
 
 #include "mkdir.h"
 #include "filemanip.h"
+#include "osgeo4w.h"
 #include "LogSingleton.h"
 
 /* Return 0 on success.
@@ -36,6 +37,11 @@ mkdir_p (int isadir, const char *in_path, mode_t mode)
   DWORD d, gse;
   WCHAR wpath[len + 6];
 
+#ifdef OSGEO4W
+  if (!osgeo4w_cygwin_file_semantics ())
+    mode = 0;
+#endif
+
   strcpy (path, in_path);
   mklongpath (wpath, path, len + 6);
 
diff --git a/osgeo4w.cc b/osgeo4w.cc
index da60632..a21b591 100644
--- a/osgeo4w.cc
+++ b/osgeo4w.cc
@@ -6,6 +6,8 @@
 
 #include "win32.h"
 #include <shlobj.h>
+#include <stdlib.h>
+#include <string.h>
 
 #include "getopt++/BoolOption.h"
 #include "getopt++/StringOption.h"
@@ -38,6 +40,30 @@ osgeo4w_process_options ()
     menu_name = (std::string) MenuNameOption;
 }
 
+bool
+osgeo4w_cygwin_file_semantics ()
+{
+  static int cached = -1;
+  if (cached < 0)
+    {
+      const char *v = getenv ("OSGEO4W_SETUP_FILE_SEMANTICS");
+      cached = v && !strcmp (v, "cygwin");
+    }
+  return cached;
+}
+
+bool
+osgeo4w_skip_symlink_pass ()
+{
+  static int cached = -1;
+  if (cached < 0)
+    {
+      const char *v = getenv ("OSGEO4W_SETUP_SKIP_SYMLINK_PASS");
+      cached = v ? (v[0] == '1') : !osgeo4w_cygwin_file_semantics ();
+    }
+  return cached;
+}
+
 bool
 get_issystem ()
 {
diff --git a/osgeo4w.h b/osgeo4w.h
index ca83ec5..f7326e2 100644
--- a/osgeo4w.h
+++ b/osgeo4w.h
@@ -39,6 +39,16 @@ extern bool safe_mode;
 extern std::string menu_name;
 void osgeo4w_process_options ();
 bool get_issystem ();
+
+/* How files are extracted.  The OSGeo4W installer of the past used plain Win32
+   file calls: files and directories inherit the ACLs of their parent, and
+   packages are read once.  Cygwin's setup gives every file and directory a
+   POSIX style ACL and reads each package a second time to create symlinks.
+   OSGEO4W_SETUP_FILE_SEMANTICS=cygwin selects the latter.  The second pass is
+   only needed if a package contains symlinks, which it does not do in the
+   plain mode; OSGEO4W_SETUP_SKIP_SYMLINK_PASS=0/1 overrides that on its own.  */
+bool osgeo4w_cygwin_file_semantics ();
+bool osgeo4w_skip_symlink_pass ();
 std::string get_startmenu ();
 std::string get_desktop ();
 #endif
