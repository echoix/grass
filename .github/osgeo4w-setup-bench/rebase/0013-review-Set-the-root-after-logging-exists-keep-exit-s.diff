From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 9 Oct 2026 23:13:27 +0000
Subject: [PATCH] review: Set the root after logging exists, keep exit status 0
 for etc/reboot, fail non-elevated in-use files, license: name form


diff --git a/iniparse.yy b/iniparse.yy
index c914e35..0b173c1 100644
--- a/iniparse.yy
+++ b/iniparse.yy
@@ -125,6 +125,7 @@ singleitem /* non-empty */
 
  | MESSAGE STRING STRING NL	{ iniBuilder->buildMessage ($2, $3); }
  | LICENSE STRING STRING MD5 NL	{ iniBuilder->buildPackageLicense ($2, $3, $4); }
+ | LICENSE STRING NL		{ iniBuilder->buildPackageLicense ($2, "0", NULL); }
  | error NL			{ yyerror (std::string("unrecognized line ")
 					  + stringify(yylineno)
 					  + " (do you have the latest setup?)");
diff --git a/install.cc b/install.cc
index 59b1685..ba4cfe5 100644
--- a/install.cc
+++ b/install.cc
@@ -64,6 +64,7 @@
 #include "processlist.h"
 #include "gui/GuiFeedback.h"
 #include "osgeo4w.h"
+#include "license.h"
 
 extern ThreeBarProgressPage Progress;
 
@@ -690,6 +691,14 @@ Installer::_installOne (packagemeta &pkgm,
                    without ever stopping the processes that use it.  */
                 if (replace_inuse_file (tarstream, prefixURL, prefixPath, fn))
                   break;
+                if (!is_elevated () || NoReplaceOnReboot)
+                  {
+                    ++errors;
+                    error_in_this_file = true;
+                    Log (LOG_PLAIN) << "Not replacing in-use file " << prefixURL
+                                    << prefixPath << fn << endLog;
+                    break;
+                  }
                 ignoreInUseErrors = true;
 #endif
                 if (!ignoreInUseErrors)
@@ -900,6 +909,19 @@ do_install_thread (HINSTANCE h, HWND owner)
   (void) i;
 #endif
 
+#ifdef OSGEO4W
+  /* installing from a local directory does not go through the download page */
+  {
+    packagedb ldb;
+    if (!accept_package_licenses (ldb.solution.transactions (), feedback, owner))
+      {
+        Log (LOG_PLAIN) << "Not all licenses were accepted" << endLog;
+        Logger ().exit (1);
+        return;
+      }
+  }
+#endif
+
   Installer myInstaller;
   myInstaller.initDialog();
 
diff --git a/license.cc b/license.cc
index 542ce4a..f9a66ae 100644
--- a/license.cc
+++ b/license.cc
@@ -38,6 +38,10 @@ basename_of (const std::string &path)
 bool
 accept_package_licenses (const SolverTransactionList &t, Feedback &feedback, HWND owner)
 {
+  static int result = -1;
+  if (result >= 0)
+    return result;
+
   std::set<std::string> asked;
   bool all_accepted = true;
 
@@ -59,7 +63,7 @@ accept_package_licenses (const SolverTransactionList &t, Feedback &feedback, HWN
       const std::string file = cygpath ("/etc/licenses/" + basename_of (info.path));
       std::string text;
       const packagesource::sitestype &sites = version.source ()->sites;
-      if (!sites.empty ())
+      if (!sites.empty () && info.size > 0)
         {
           io_stream::mkpath_p (PATH_TO_FILE, "file://" + file, 0);
           if (get_url_to_file (sites[0].key + info.path, file, info.size, feedback))
@@ -100,6 +104,7 @@ accept_package_licenses (const SolverTransactionList &t, Feedback &feedback, HWN
         all_accepted = false;
     }
 
+  result = all_accepted;
   return all_accepted;
 }
 #endif
diff --git a/main.cc b/main.cc
index d4ca1d7..d183512 100644
--- a/main.cc
+++ b/main.cc
@@ -314,6 +314,10 @@ WinMain (HINSTANCE h,
     if (unattended_mode || output_only || !elevate)
       set_cout ();
 
+    /* Start logging only if we don't elevate.  Same for setting default
+       security settings. */
+    LogSingleton::SetInstance (*LogFile::createLogFile ());
+
 #ifdef OSGEO4W
     /* The installation root is --root, else OSGEO4W_ROOT, else a default which
        depends on whether we run elevated.  An explicitly given root also holds
@@ -331,9 +335,6 @@ WinMain (HINSTANCE h,
       }
 #endif
 
-    /* Start logging only if we don't elevate.  Same for setting default
-       security settings. */
-    LogSingleton::SetInstance (*LogFile::createLogFile ());
     const char *sep = isdirsep (local_dir[local_dir.size () - 1])
 				? "" : "\\";
 
diff --git a/osgeo4w.cc b/osgeo4w.cc
index b39a395..843662e 100644
--- a/osgeo4w.cc
+++ b/osgeo4w.cc
@@ -99,7 +99,8 @@ std::string
 get_desktop ()
 {
   return special_folder (get_issystem () ? CSIDL_COMMON_DESKTOPDIRECTORY
-                                         : CSIDL_DESKTOPDIRECTORY);
+                                         : CSIDL_DESKTOPDIRECTORY)
+    + "\\" + menu_name;
 }
 
 #endif /* OSGEO4W */
diff --git a/postinstall.cc b/postinstall.cc
index 7086aad..4c82919 100644
--- a/postinstall.cc
+++ b/postinstall.cc
@@ -254,8 +254,8 @@ do_postinstall_reflector (void *p)
     if (io_stream::exists ("cygfile:///etc/reboot"))
       {
         io_stream::remove ("cygfile:///etc/reboot");
+        /* Only logged: the exit status of setup stays 0, as it always was.  */
         Log (LOG_TIMESTAMP) << "A script detected that a reboot is due" << endLog;
-        rebootneeded = true;
       }
 #endif
 
