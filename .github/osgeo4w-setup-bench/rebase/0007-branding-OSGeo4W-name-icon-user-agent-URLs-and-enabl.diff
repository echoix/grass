--- a/res.rc
+++ b/res.rc
@@ -52,9 +52,16 @@ CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "setup.exe.manifest"
 
 // Icon with lowest ID value placed first to ensure application icon
 // remains consistent on all systems.
+#ifdef OSGEO4W
+/* osgeo.ico is copied from the OSGeo4W repository, src/setup/osgeo.ico */
+IDI_CYGWIN_SETUP        ICON    "osgeo.ico"
+IDI_CYGWIN              ICON    "osgeo.ico"
+IDI_CYGWIN_TERMINAL     ICON    "osgeo.ico"
+#else
 IDI_CYGWIN_SETUP        ICON    "cygwin-setup.ico"
 IDI_CYGWIN              ICON    "cygwin.ico"
 IDI_CYGWIN_TERMINAL     ICON    "cygwin-terminal.ico"
+#endif
 IDI_TREE_PLUS           ICON    "tree-plus.ico"
 IDI_TREE_MINUS          ICON    "tree-minus.ico"
 
@@ -63,9 +70,13 @@ IDI_TREE_MINUS          ICON    "tree-minus.ico"
 // FILE
 //
 
+#ifdef OSGEO4W
+OSGEO4W.ICON            FILE    "osgeo.ico"
+#else
 CYGWIN-SETUP.ICON       FILE    "cygwin-setup.ico"
 CYGWIN.ICON             FILE    "cygwin.ico"
 CYGWIN-TERMINAL.ICON    FILE    "cygwin-terminal.ico"
+#endif
 
 /////////////////////////////////////////////////////////////////////////////
 //
