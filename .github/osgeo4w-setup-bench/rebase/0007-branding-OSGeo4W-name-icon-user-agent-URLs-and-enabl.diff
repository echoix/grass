From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 9 Oct 2026 22:41:21 +0000
Subject: [PATCH] branding: OSGeo4W name, icon, user agent, URLs and
 --enable-osgeo4w


diff --git a/Makefile.am b/Makefile.am
index 27ea1bd..787eae7 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -28,7 +28,7 @@ AM_CFLAGS = $(BASECXXFLAGS) -Wmissing-declarations -Winline \
 AM_YFLAGS = -d
 AM_LFLAGS = -8
 WINDRES = @WINDRES@
-AM_CPPFLAGS = -D__USE_MINGW_ANSI_STDIO=1 -D_FILE_OFFSET_BITS=64 -DLZMA_API_STATIC \
+AM_CPPFLAGS = @OSGEO4W_CPPFLAGS@ -D__USE_MINGW_ANSI_STDIO=1 -D_FILE_OFFSET_BITS=64 -DLZMA_API_STATIC \
 	       -I$(srcdir)/libgetopt++/include \
 	       $(ZLIB_CFLAGS) $(LZMA_CFLAGS) $(ZSTD_CFLAGS) $(LIBCRYPT_CFLAGS) $(LIBSOLV_CFLAGS)
 
@@ -354,7 +354,7 @@ po2rc:
 res.o: setup.exe.manifest res/en/res.rc $(foreach l,$(LINGUAS),res/$l/res.rc)
 
 .rc.o:
-	$(AM_V_GEN)$(WINDRES) --codepage 65001 --include-dir $(srcdir) -o $@ $<
+	$(AM_V_GEN)$(WINDRES) --codepage 65001 @OSGEO4W_CPPFLAGS@ --include-dir $(srcdir) -o $@ $<
 
 setup-src:
 	@ver=setup-$(VER);\
diff --git a/configure.ac b/configure.ac
index 5de367f..fbe6d39 100644
--- a/configure.ac
+++ b/configure.ac
@@ -95,5 +95,15 @@ AC_COMPILE_IFELSE(
   [AC_MSG_RESULT([ok])],
   [AC_MSG_FAILURE([Must not be built with a compiler which uses dwarf2 exception handling])])
 
+dnl OSGeo4W installer: Cygwin only code is disabled (see osgeo4w.h)
+AC_ARG_ENABLE([osgeo4w],
+  [AS_HELP_STRING([--enable-osgeo4w], [build the OSGeo4W installer instead of Cygwin setup])],
+  [], [enable_osgeo4w=yes])
+OSGEO4W_CPPFLAGS=
+if test "x$enable_osgeo4w" = "xyes"; then
+  OSGEO4W_CPPFLAGS="-DOSGEO4W=1"
+fi
+AC_SUBST(OSGEO4W_CPPFLAGS)
+
 AC_CONFIG_FILES([Makefile tests/Makefile])
 AC_OUTPUT
diff --git a/nio-ie5.cc b/nio-ie5.cc
index c2ee167..80db7b1 100644
--- a/nio-ie5.cc
+++ b/nio-ie5.cc
@@ -45,6 +45,18 @@ determine_default_useragent(void)
   std::stringstream os;
   os << "Windows NT " << OSMajorVersion() << "." << OSMinorVersion() << "." << OSBuildNumber();
 
+  typedef LANGID (WINAPI *PFNGETTHREADUILANGUAGE)();
+  PFNGETTHREADUILANGUAGE pfnGetThreadUILanguage = (PFNGETTHREADUILANGUAGE)GetProcAddress(GetModuleHandle("kernel32"), "GetThreadUILanguage");
+  std::stringstream langid;
+  if (pfnGetThreadUILanguage)
+    {
+      LANGID l = pfnGetThreadUILanguage();
+      langid << std::hex << std::setw(4) << std::setfill('0') << l;
+    }
+
+#ifdef OSGEO4W
+  default_useragent = std::string("OSGeo4W-Setup/") + setup_version + " (" + os.str () + ";Win64;" + langid.str () + ")";
+#else
 #ifdef __x86_64__
   USHORT processMachine = IMAGE_FILE_MACHINE_AMD64;
 #else
@@ -59,15 +71,6 @@ determine_default_useragent(void)
   else
     bitness = machine_name(processMachine);
 
-  typedef LANGID (WINAPI *PFNGETTHREADUILANGUAGE)();
-  PFNGETTHREADUILANGUAGE pfnGetThreadUILanguage = (PFNGETTHREADUILANGUAGE)GetProcAddress(GetModuleHandle("kernel32"), "GetThreadUILanguage");
-  std::stringstream langid;
-  if (pfnGetThreadUILanguage)
-    {
-      LANGID l = pfnGetThreadUILanguage();
-      langid << std::hex << std::setw(4) << std::setfill('0') << l;
-    }
-
   std::string symlinks = "";
   if (nt_sec.hasSymlinkCreationRights())
     symlinks.append("SymLinkPriv");
@@ -79,6 +82,7 @@ determine_default_useragent(void)
     }
 
   default_useragent = std::string("Cygwin-Setup/") + setup_version + " (" + os.str() + ";" + bitness + ";" + langid.str() + ";" + symlinks + ")";
+#endif
   Log (LOG_BABBLE) << "User-Agent: default is \"" << default_useragent << "\"" << endLog;
 
   return default_useragent;
