 {
@@ -107,7 +109,52 @@ modify_CYGWIN ()
 
   SetEnvironmentVariable ("CYGWIN", cygwin.c_str());
 }
+#endif
+
+#ifdef OSGEO4W
+/* Post-install scripts of OSGeo4W packages are batch files.  They run with the
+   environment of the user, with the installation's bin directory in front of
+   PATH, and are told where and how OSGeo4W is installed.  */
+void
+init_run_script ()
+{
+  static bool initialized;
+  if (initialized)
+    return;
+
+  initialized = true;
 
+  DWORD len = GetEnvironmentVariable ("PATH", NULL, 0);
+  std::string old_path (len, '\0');
+  if (len)
+    {
+      GetEnvironmentVariable ("PATH", &old_path[0], len);
+      old_path.resize (len - 1);
+    }
+  SetEnvironmentVariable ("PATH", backslash (cygpath ("/bin") + ";" + old_path).c_str ());
+
+  SetEnvironmentVariable ("OSGEO4W_ROOT", get_root_dir ().c_str ());
+  SetEnvironmentVariable ("OSGEO4W_SYSTEM_INSTALL", get_issystem () ? "1" : "0");
+  SetEnvironmentVariable ("OSGEO4W_STARTMENU", get_startmenu ().c_str ());
+  SetEnvironmentVariable ("OSGEO4W_DESKTOP", get_desktop ().c_str ());
+  SetEnvironmentVariable ("OSGEO4W_MENU_LINKS", root_menu ? "1" : "0");
+  SetEnvironmentVariable ("OSGEO4W_DESKTOP_LINKS", root_desktop ? "1" : "0");
+
+  /* C:\OSGeo4W -> /C/OSGeo4W, the root as MSYS sees it */
+  std::string msys = get_root_dir ();
+  if (msys.size () > 1 && msys[1] == ':')
+    {
+      msys[1] = msys[0];
+      msys[0] = '/';
+    }
+  for (std::string::iterator c = msys.begin (); c != msys.end (); ++c)
+    if (*c == '\\')
+      *c = '/';
+  SetEnvironmentVariable ("OSGEO4W_ROOT_MSYS", msys.c_str ());
+
+  cmd = "cmd.exe";
+}
+#else
 void
 init_run_script ()
 {
@@ -159,6 +206,7 @@ init_run_script ()
   dash = backslash (cygpath ("/bin/dash.exe"));
   cmd  = "cmd.exe";
 }
+#endif
 
