diff --git a/osgeo4w.cc b/osgeo4w.cc
new file mode 100644
index 0000000..da60632
--- /dev/null
+++ b/osgeo4w.cc
@@ -0,0 +1,74 @@
+/*
+ * Options and settings that only the OSGeo4W installer has, see osgeo4w.h.
+ */
+
+#ifdef OSGEO4W
+
+#include "win32.h"
+#include <shlobj.h>
+
+#include "getopt++/BoolOption.h"
+#include "getopt++/StringOption.h"
+
+#include "osgeo4w.h"
+#include "resource.h"
+#include "state.h"
+#include "mount.h"
+
+BoolOption AutoAcceptLicenseOption (false, 'k', "autoaccept", IDS_HELPTEXT_AUTOACCEPT);
+BoolOption DesktopOption (false, 'T', "desktop", IDS_HELPTEXT_DESKTOP);
+static BoolOption TestOption (false, 't', "test", IDS_HELPTEXT_TEST);
+static BoolOption SafeModeOption (false, 'S', "safe", IDS_HELPTEXT_SAFE);
+static StringOption MenuNameOption ("", 'm', "menu-name", IDS_HELPTEXT_MENU_NAME, false);
+/* OSGeo4W has no separate express mode in this version of setup; the options
+   are accepted so that existing command lines keep working.  */
+static BoolOption AdvancedOption (true, 'A', "advanced", IDS_HELPTEXT_ADVANCED);
+static BoolOption ExpressOption (false, 'E', "express", IDS_HELPTEXT_EXPRESS);
+
+bool safe_mode = false;
+std::string menu_name = "OSGeo4W";
+
+/* Called after the command line was parsed.  */
+void
+osgeo4w_process_options ()
+{
+  test_mode = TestOption;
+  safe_mode = SafeModeOption;
+  if (((std::string) MenuNameOption).size ())
+    menu_name = (std::string) MenuNameOption;
+}
+
+bool
+get_issystem ()
+{
+  return root_scope == IDC_ROOT_SYSTEM;
+}
+
+static std::string
+special_folder (int csidl)
+{
+  char path[MAX_PATH];
+  LPITEMIDLIST id;
+  if (FAILED (SHGetSpecialFolderLocation (NULL, csidl, &id)))
+    return "";
+  if (!SHGetPathFromIDList (id, path))
+    path[0] = '\0';
+  CoTaskMemFree (id);
+  return path;
+}
+
+std::string
+get_startmenu ()
+{
+  return special_folder (get_issystem () ? CSIDL_COMMON_PROGRAMS : CSIDL_PROGRAMS)
+    + "\\" + menu_name;
+}
+
+std::string
+get_desktop ()
+{
+  return special_folder (get_issystem () ? CSIDL_COMMON_DESKTOPDIRECTORY
+                                         : CSIDL_DESKTOPDIRECTORY);
+}
+
+#endif /* OSGEO4W */
diff --git a/osgeo4w.h b/osgeo4w.h
index 8cbeea1..ca83ec5 100644
--- a/osgeo4w.h
+++ b/osgeo4w.h
@@ -11,11 +11,36 @@
 
 #ifdef OSGEO4W
 #define SETUP_NAME "OSGeo4W"
+/* Short options: OSGeo4W setup always used -b for --disable-buggy-antivirus,
+   -t for --test, -m for --menu-name and -S for --safe.  Cygwin's setup has
+   since given these letters to other options, which lose their short form.  */
+#define OSGEO4W_OPT_ANTIVIRUS 'b'
+#define OSGEO4W_OPT_ALLOW_TEST '\0'
+#define OSGEO4W_OPT_MIRROR_MODE '\0'
+#define OSGEO4W_OPT_SEXPR_PUBKEY '\0'
+
 #ifndef OSGEO4W_MIRROR_URL
 #define OSGEO4W_MIRROR_URL "https://download.osgeo.org/osgeo4w/ssl/mirrors.lst"
 #endif
 #else
 #define SETUP_NAME "Cygwin"
+#define OSGEO4W_OPT_ANTIVIRUS 'A'
+#define OSGEO4W_OPT_ALLOW_TEST 't'
+#define OSGEO4W_OPT_MIRROR_MODE 'm'
+#define OSGEO4W_OPT_SEXPR_PUBKEY 'S'
+#endif
+
+#ifdef OSGEO4W
+#include <string>
+class BoolOption;
+extern BoolOption AutoAcceptLicenseOption;
+extern BoolOption DesktopOption;
+extern bool safe_mode;
+extern std::string menu_name;
+void osgeo4w_process_options ();
+bool get_issystem ();
+std::string get_startmenu ();
+std::string get_desktop ();
 #endif
 
 #endif /* SETUP_OSGEO4W_H */
