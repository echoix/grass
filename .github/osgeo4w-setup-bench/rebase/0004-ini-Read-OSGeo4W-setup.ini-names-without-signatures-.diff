diff --git a/iniparse.yy b/iniparse.yy
index ca9b8a7..c914e35 100644
--- a/iniparse.yy
+++ b/iniparse.yy
@@ -59,6 +59,7 @@ extern int yylineno;
 %token BUILDDEPENDS
 %token OBSOLETES
 %token MESSAGE
+%token LICENSE
 %token ARCH RELEASE
 
 %%
@@ -123,6 +124,7 @@ singleitem /* non-empty */
  | REPLACE_VERSIONS versionlist NL
 
  | MESSAGE STRING STRING NL	{ iniBuilder->buildMessage ($2, $3); }
+ | LICENSE STRING STRING MD5 NL	{ iniBuilder->buildPackageLicense ($2, $3, $4); }
  | error NL			{ yyerror (std::string("unrecognized line ")
 					  + stringify(yylineno)
 					  + " (do you have the latest setup?)");
diff --git a/license.cc b/license.cc
new file mode 100644
index 0000000..1264b89
--- /dev/null
+++ b/license.cc
@@ -0,0 +1,7 @@
+/*
+ * License files of OSGeo4W packages, see license.h.
+ */
+
+#include "license.h"
+
+std::map<std::string, LicenseInfo> package_licenses;
diff --git a/license.h b/license.h
new file mode 100644
index 0000000..f35ac84
--- /dev/null
+++ b/license.h
@@ -0,0 +1,25 @@
+/*
+ * License files of OSGeo4W packages.  setup.ini lines of the form
+ *
+ *   license: <path of the license file> <size> <md5>
+ *
+ * name a text a user has to accept before the package version is installed.
+ */
+
+#ifndef SETUP_LICENSE_H
+#define SETUP_LICENSE_H
+
+#include <map>
+#include <string>
+
+struct LicenseInfo
+{
+  std::string path;     /* relative to the mirror */
+  size_t size;
+  unsigned char md5[16];
+};
+
+/* keyed by "<package name> <version>" */
+extern std::map<std::string, LicenseInfo> package_licenses;
+
+#endif /* SETUP_LICENSE_H */
