 #include "csu_util/version_compare.h"
 
@@ -48,7 +50,11 @@ IniDBBuilderPackage::buildTimestamp (const std::string& time)
 static std::string
 setup_dl_url()
 {
+#ifdef OSGEO4W
+  return "https://download.osgeo.org/osgeo4w/osgeo4w-setup.exe";
+#else
   return "https://cygwin.com/setup-" + machine_name(WindowsProcessMachine()) +".exe";
+#endif
 }
 
 void
@@ -356,6 +362,21 @@ IniDBBuilderPackage::buildPackageListOperatorVersion (const std::string& aVersio
     }
 }
 
+void
+IniDBBuilderPackage::buildPackageLicense (const std::string& path,
+                                          const std::string& size,
+                                          char *md5)
+{
+  /* The line follows version: and install:, so this is the version it is for.  */
+  LicenseInfo info;
+  info.path = path;
+  info.size = atoi (size.c_str ());
+  if (md5)
+    memcpy (info.md5, md5, sizeof info.md5);
+  package_licenses[name + " " + cbpv.version] = info;
+  delete[] md5;
+}
+
 void
 IniDBBuilderPackage::buildMessage (const std::string& _message_id, const std::string& _message_string)
 {
