   return SetupBaseNameOption;
 }
 
@@ -129,7 +139,14 @@ check_ini_sig (io_stream* ini_file, io_stream* ini_sig_file,
      current setup and record the result.  On a failed signature check
      the streams are invalidated so even if we tried to read in the
      setup anyway there's be nothing to parse. */
+#ifdef OSGEO4W
+  /* The OSGeo4W setup.ini is not signed.  */
+  (void) ini_sig_file; (void) sig_fail; (void) site; (void) sig_name;
+  (void) feedback;
+  if (false)
+#else
   if (!NoVerifyOption && ini_file)
+#endif
     {
       if (!ini_sig_file) {
 	// don't complain if the user installs from localdir and no
@@ -239,7 +256,11 @@ do_remote_ini (Feedback &myFeedback)
 	  current_ini_ext = *ext;
 	  current_ini_name = n->url + SetupArch() + "/" + SetupBaseName() + "." + current_ini_ext;
 	  current_ini_sig_name = current_ini_name + ".sig";
+#ifdef OSGEO4W
+	  ini_sig_file = NULL;
+#else
 	  ini_sig_file = get_url_to_membuf (current_ini_sig_name, myFeedback);
+#endif
 	  ini_file = get_url_to_membuf (current_ini_name, myFeedback);
 	  ini_file = check_ini_sig (ini_file, ini_sig_file, sig_fail,
 				    n->url.c_str (), current_ini_sig_name.c_str (), myFeedback);
