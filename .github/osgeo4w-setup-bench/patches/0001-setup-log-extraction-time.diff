+  if (const char *timing_file = getenv ("OSGEO4W_EXTRACT_TIMING_FILE"))
+    if (FILE *f = fopen (timing_file, "a"))
+      {
+        fprintf (f, "Extracted %s: %lu entries in %lu ms\n", pkgm.name.c_str (),
+                 extracted_entries, extract_ms);
+        fclose (f);
+      }
+
   if (lst)
     delete lst;
